# Use explicit keys for data.neuro.polymtl.ca
Host data.neuro.polymtl.ca
    IdentityFile ~/.ssh/id_ed25519
    IdentityFile ~/.ssh/id_ed25519_root
    IdentitiesOnly yes
    PreferredAuthentications publickey

# Allow password-based authentication for all NeuroPoly servers
Host *.neuro.polymtl.ca !data.neuro.polymtl.ca
    User p114154
    PreferredAuthentications password
